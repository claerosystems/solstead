# User-level unit: ~/.config/systemd/user/solstead.service (no root required; needs linger).
[Unit]
Description=Solstead controller (user service)
After=network-online.target

[Service]
Type=notify
WatchdogSec=90
TimeoutStopSec=20
ExecStart=%h/solstead/controller/.venv/bin/solstead serve %h/.config/solstead/config.json
Restart=always
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
