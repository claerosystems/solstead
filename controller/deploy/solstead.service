[Unit]
Description=Solstead controller
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/solstead

[Service]
Type=notify
WatchdogSec=90
TimeoutStopSec=20
User=solstead
Group=solstead
ExecStart=/opt/solstead/venv/bin/solstead serve /etc/solstead/config.json
Restart=always
RestartSec=5
StartLimitIntervalSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/solstead
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_NETLINK: `ip route` reads the default routes for the uplink and failover.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
